      <item row="1" column="1">
       <widget class="QComboBox" name="labelStyleComboBox">
        <property name="toolTip">
         <string>Writes the word REDACTED in the centre of every redacted box, so a reader can see that something was removed on purpose. The word is drawn as shapes, it is not searchable text.</string>
        </property>
       </widget>
      </item>
